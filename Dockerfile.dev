# Development image shared by the gateway and mock-upstream services in compose.yml.
# Source is bind-mounted at runtime; only dependencies are baked in.
FROM node:22-alpine

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH
RUN corepack enable && apk add --no-cache python3 make g++

WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/gateway/package.json apps/gateway/
COPY apps/dashboard/package.json apps/dashboard/
COPY apps/mock-upstream/package.json apps/mock-upstream/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile

COPY . .
