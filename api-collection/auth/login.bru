meta {
  name: login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/v1/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  bru.setVar("adminToken", res.body.accessToken);
}

tests {
  test("returns a 12 hour session", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.expiresIn).to.equal(43200);
  });
}
