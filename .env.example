# OmniGate environment - copy to .env for local development.
# Reference: docs/10-DEPLOYMENT-RUNBOOK.md section 3 and docs/05-RATE-LIMIT-AND-CACHE.md section 3.

# --- Runtime ---
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=false

# --- Docker compose host ports (only used by compose.yml; change if these clash with local services) ---
REDIS_HOST_PORT=6379
POSTGRES_HOST_PORT=5432

# --- Data stores (required) ---
DATABASE_URL=postgresql://omnigate:omnigate@localhost:5432/omnigate
REDIS_URL=redis://localhost:6379

# --- Routing ---
ROUTES_FILE=./routes.yaml
ALLOW_PRIVATE_UPSTREAMS=true

# --- Auth on the gateway data plane (one of JWT_SECRET / JWT_JWKS_URL) ---
# MUST CHANGE before NODE_ENV=production: the gateway refuses to boot on this value.
# One of JWT_SECRET (HS256) or JWT_JWKS_URL (RS256) is required.
JWT_SECRET=dev-only-change-me-to-32-plus-random-bytes
# When your identity provider signs tokens for other apps too, pin these or every one of them is valid here.
# JWT_ISSUER=https://idp.example.com/
# JWT_AUDIENCE=omnigate
# JWT_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# MUST CHANGE before NODE_ENV=production. Rotating it invalidates every issued API key.
API_KEY_PEPPER=dev-only-change-me-rotating-invalidates-all-keys

# --- Admin / dashboard ---
ADMIN_EMAIL=admin@example.com
# MUST CHANGE before NODE_ENV=production: the gateway refuses to boot on this value.
ADMIN_PASSWORD=admin
# MUST CHANGE before NODE_ENV=production; must differ from JWT_SECRET.
ADMIN_JWT_SECRET=dev-only-must-differ-from-JWT_SECRET
CORS_ORIGIN=http://localhost:5173

# --- Proxy ---
MAX_BODY_BYTES=1048576
UPSTREAM_TIMEOUT_MS=30000

# --- Rate limiting & cache ---
RL_DEFAULT_WINDOW_S=60
RL_DEFAULT_MAX=100
# Extra per-IP cap for anonymous callers on open routes, on top of the route's own rate_limit and
# shared across all open routes (window = RL_DEFAULT_WINDOW_S). This is why the README's 31-request
# loop trips at 30 even though the route allows 100.
RL_ANON_MAX=30
RL_COUNT_CACHE_HITS=true
RL_FAIL_OPEN=true
CACHE_MAX_BODY_BYTES=262144
CACHE_DEFAULT_VARY_ON_PRINCIPAL=true

# --- Anomaly detection ---
ANOMALY_SAMPLE_RATE=0.02
ANOMALY_GATE_THRESHOLD=0.4
ANOMALY_BLOCK_THRESHOLD=0.9
# Global switch for every refusal the anomaly stage can make (heuristic fast block, sync 403,
# reactive throttle). false = observe only: scored, recorded, reviewable, never refused.
ANOMALY_ENFORCE=true
ANOMALY_AUTO_THROTTLE=false
# Provider for the anomaly classifier. `fake` is a deterministic stub: no account, no network.
#   openai    - OpenAI, or ANY OpenAI-compatible endpoint via LLM_BASE_URL (Groq, Together, vLLM, ...)
#   anthropic - Anthropic Messages API
#   local     - an OpenAI-compatible server you run yourself; defaults to Ollama on :11434
#   fake      - deterministic rule stub used by tests, CI and offline development
LLM_PROVIDER=fake
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1     # free tier, OpenAI-compatible
# LLM_BASE_URL=http://localhost:11434/v1          # Ollama (LLM_PROVIDER=local)
LLM_MAX_OUTPUT_TOKENS=200
LLM_TIMEOUT_SYNC_MS=800
LLM_TIMEOUT_ASYNC_MS=5000
LLM_DAILY_CALL_CAP=20000

# Reactive throttling: N events at or above score 0.7 within the window flag the principal.
ANOMALY_THROTTLE_EVENTS=3
ANOMALY_THROTTLE_WINDOW_S=300
ANOMALY_THROTTLE_SECONDS=600
EXPOSE_ANOMALY_SCORE=true

# --- Worker & retention ---
WORKER_INLINE=true
LOG_RETENTION_DAYS=30

# --- learned route schema -----------------------------------------------------------------------
# Flags parameter names a route has never legitimately accepted. Measured as the strongest single
# detector in the gateway; see docs/results/anomaly-eval-csic.md.
SCHEMA_LEARNING=true
# The signal stays silent until a route has contributed this many successful, unremarkable requests.
SCHEMA_WARMUP_REQUESTS=500
# A new parameter name is only accepted after this many distinct callers have used it successfully,
# so one attacker cannot teach the schema.
SCHEMA_PROMOTE_PRINCIPALS=3
SCHEMA_MAX_NAMES=256
# Also check that parameter values look like what that parameter has carried before. Off by default:
# it is the largest single recall gain measured (0.494 -> 0.891 on CSIC 2010) and the only signal
# with a non-zero false-positive count, so it is a trade rather than a free win.
SCHEMA_VALUE_SHAPES=false

# --- metrics ------------------------------------------------------------------------------------
# Bearer token for GET /metrics (Prometheus text format). Leave unset and the endpoint serves in
# development and 404s in production: an open metrics endpoint on a public URL discloses traffic
# shape and how close the anomaly stage is to firing.
# METRICS_TOKEN=
