{
  "name": "omnigate",
  "version": "0.1.0",
  "private": true,
  "description": "OmniGate - AI-powered API gateway: JWT/API-key auth, Redis rate limiting and caching, LLM-assisted anomaly detection, React dashboard",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm gen && pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm gen && pnpm -r typecheck",
    "test": "pnpm gen && pnpm -r test",
    "dev:gateway": "pnpm --filter @omnigate/gateway start:dev",
    "dev:dashboard": "pnpm --filter @omnigate/dashboard dev",
    "test:e2e": "pnpm gen && pnpm --filter @omnigate/gateway test:e2e",
    "gen": "pnpm --filter @omnigate/shared build && pnpm --filter @omnigate/gateway prisma:generate",
    "test:integration": "pnpm gen && pnpm --filter @omnigate/gateway test:integration",
    "seed": "pnpm --filter @omnigate/gateway seed"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
